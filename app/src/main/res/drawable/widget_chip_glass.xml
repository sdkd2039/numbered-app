<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- جسم الزجاج -->
    <item>

        <shape android:shape="rectangle">

            <corners android:radius="14dp" />

            <gradient
                android:angle="135"
                android:startColor="#263B4D61"
                android:endColor="#18253240" />

        </shape>

    </item>

    <!-- لمعة خفيفة -->
    <item
        android:bottom="18dp">

        <shape android:shape="rectangle">

            <corners android:radius="14dp" />

            <gradient
                android:angle="270"
                android:startColor="#12FFFFFF"
                android:endColor="#00FFFFFF" />

        </shape>

    </item>

    <!-- حدود -->
    <item>

        <shape android:shape="rectangle">

            <corners android:radius="14dp" />

            <stroke
                android:width="1dp"
                android:color="#263F5368" />

        </shape>

    </item>

</layer-list>