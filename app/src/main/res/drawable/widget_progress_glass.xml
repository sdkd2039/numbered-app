<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- مسار الشريط -->
    <item android:id="@android:id/background">

        <shape android:shape="rectangle">

            <corners android:radius="8dp" />

            <solid android:color="#26313F4D" />

            <stroke
                android:width="1dp"
                android:color="#182F4052" />

        </shape>

    </item>

    <!-- التقدم -->
    <item android:id="@android:id/progress">

        <clip>

            <shape android:shape="rectangle">

                <corners android:radius="8dp" />

                <gradient
                    android:angle="0"
                    android:startColor="#4F9BE8"
                    android:centerColor="#62A9F5"
                    android:endColor="#7AB8FF" />

            </shape>

        </clip>

    </item>

</layer-list>