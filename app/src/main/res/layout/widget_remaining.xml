<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/remaining_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="6dp"
    android:background="#1B1F26">

    <!-- اسم الحدث + شعار التطبيق -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layoutDirection="rtl">

        <ImageView
            android:layout_width="25dp"
            android:layout_height="19dp"
            android:layout_marginEnd="5dp"
            android:contentDescription="معدودات"
            android:scaleType="centerInside"
            android:src="@drawable/numbered" />

        <TextView
            android:id="@+id/remaining_event_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/the_year_of_handicrafts_bold"
            android:gravity="end|center_vertical"
            android:maxLines="1"
            android:textColor="#F4F7FB"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- العداد الرقمي -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:layoutDirection="rtl">

        <!-- الأيام -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/timer_unit_background">

            <TextView
                android:id="@+id/remaining_days"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fontFamily="@font/the_year_of_handicrafts_bold"
                android:gravity="center"
                android:maxLines="1"
                android:text="00"
                android:textColor="#62A9F5"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/the_year_of_handicrafts_bold"
                android:gravity="center"
                android:maxLines="1"
                android:text="يوم"
                android:textColor="#9CA8B8"
                android:textSize="8sp" />

        </LinearLayout>

        <!-- الساعات -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/timer_unit_background">

            <TextView
                android:id="@+id/remaining_hours"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fontFamily="@font/the_year_of_handicrafts_bold"
                android:gravity="center"
                android:maxLines="1"
                android:text="00"
                android:textColor="#62A9F5"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/the_year_of_handicrafts_bold"
                android:gravity="center"
                android:maxLines="1"
                android:text="ساعة"
                android:textColor="#9CA8B8"
                android:textSize="8sp" />

        </LinearLayout>

        <!-- الدقائق -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/timer_unit_background">

            <TextView
                android:id="@+id/remaining_minutes"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fontFamily="@font/the_year_of_handicrafts_bold"
                android:gravity="center"
                android:maxLines="1"
                android:text="00"
                android:textColor="#62A9F5"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/the_year_of_handicrafts_bold"
                android:gravity="center"
                android:maxLines="1"
                android:text="دقيقة"
                android:textColor="#9CA8B8"
                android:textSize="8sp" />

        </LinearLayout>

        <!-- الثواني -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/timer_unit_background">

            <TextView
                android:id="@+id/remaining_seconds"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fontFamily="@font/the_year_of_handicrafts_bold"
                android:gravity="center"
                android:maxLines="1"
                android:text="00"
                android:textColor="#62A9F5"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/the_year_of_handicrafts_bold"
                android:gravity="center"
                android:maxLines="1"
                android:text="ثانية"
                android:textColor="#9CA8B8"
                android:textSize="8sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- التاريخ الهجري -->
    <TextView
        android:id="@+id/remaining_hijri_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:fontFamily="@font/the_year_of_handicrafts_bold"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#8995A6"
        android:textSize="8sp" />

</LinearLayout>