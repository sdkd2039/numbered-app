<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/remaining_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="6dp"
    android:background="@drawable/remaining_widget_background">

    <!-- العنوان -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layoutDirection="rtl">

        <ImageView
            android:id="@+id/remaining_logo"
            android:layout_width="28dp"
            android:layout_height="22dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="المتبقي"
            android:scaleType="centerInside"
            android:src="@drawable/residual" />

        <TextView
            android:id="@+id/remaining_event_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical|end"
            android:maxLines="1"
            android:textAppearance="@style/WidgetZainTextAppearance"
            android:textColor="#F4F7FB"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- العدادات -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:layoutDirection="rtl">

        <!-- الأيام -->
        <LinearLayout
            android:id="@+id/remaining_days_box"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/timer_unit_background">

            <TextView
                android:id="@+id/remaining_days"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:text="0"
                android:textAppearance="@style/WidgetZainTextAppearance"
                android:textColor="#62A9F5"
                android:textSize="22sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:text="اليوم"
                android:textAppearance="@style/WidgetZainTextAppearance"
                android:textColor="#AEB9C8"
                android:textSize="9sp" />

        </LinearLayout>

        <!-- الساعات -->
        <LinearLayout
            android:id="@+id/remaining_hours_box"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/timer_unit_background">

            <TextView
                android:id="@+id/remaining_hours"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:text="0"
                android:textAppearance="@style/WidgetZainTextAppearance"
                android:textColor="#62A9F5"
                android:textSize="22sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:text="الساعة"
                android:textAppearance="@style/WidgetZainTextAppearance"
                android:textColor="#AEB9C8"
                android:textSize="9sp" />

        </LinearLayout>

        <!-- الدقائق -->
        <LinearLayout
            android:id="@+id/remaining_minutes_box"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/timer_unit_background">

            <TextView
                android:id="@+id/remaining_minutes"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:text="0"
                android:textAppearance="@style/WidgetZainTextAppearance"
                android:textColor="#62A9F5"
                android:textSize="22sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:text="الدقيقة"
                android:textAppearance="@style/WidgetZainTextAppearance"
                android:textColor="#AEB9C8"
                android:textSize="9sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- شريط التقدم -->
    <ProgressBar
        android:id="@+id/remaining_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progress="0"
        android:indeterminate="false"
        android:progressDrawable="@drawable/remaining_progress" />

    <!-- التاريخ -->
    <TextView
        android:id="@+id/remaining_hijri_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="@style/WidgetZainTextAppearance"
        android:textColor="#8995A6"
        android:textSize="8sp" />

</LinearLayout>