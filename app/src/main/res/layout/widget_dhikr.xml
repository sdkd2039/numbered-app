<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dhikr_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/dhikr_widget_background"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="5dp"
        android:paddingEnd="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="19dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="معدودات"
                android:scaleType="centerInside"
                android:src="@drawable/numbered" />

            <TextView
                android:id="@+id/dhikr_group"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end|center_vertical"
                android:maxLines="1"
                android:fontFamily="@font/the_year_of_handicrafts_bold"
                android:text="الذكر"
                android:textColor="#8FB9E8"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/dhikr_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="3"
            android:fontFamily="@font/the_year_of_handicrafts_bold"
            android:text="لا توجد بيانات متاحة"
            android:textColor="#F4F7FB"
            android:textDirection="rtl"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/dhikr_count_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:fontFamily="@font/the_year_of_handicrafts_bold"
            android:textColor="#AEB9C8"
            android:textSize="8sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <LinearLayout
            android:layout_width="wrap_content"
        android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/dhikr_group_previous"
                android:layout_width="25dp"
                android:layout_height="24dp"
                android:background="@drawable/dhikr_widget_button"
                android:fontFamily="@font/the_year_of_handicrafts_bold"
                android:gravity="center"
                android:text="‹"
                android:textColor="#DDE9FF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/dhikr_group_next"
                android:layout_width="25dp"
                android:layout_height="24dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/dhikr_widget_button"
                android:fontFamily="@font/the_year_of_handicrafts_bold"
                android:gravity="center"
                android:text="›"
                android:textColor="#DDE9FF"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/dhikr_progress"
            android:layout_width="46dp"
            android:layout_height="27dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/dhikr_widget_counter"
            android:fontFamily="@font/the_year_of_handicrafts_bold"
            android:gravity="center"
            android:maxLines="1"
            android:text="1 / 1"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/dhikr_counter_card"
            android:layout_width="46dp"
            android:layout_height="23dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/dhikr_widget_surface"
            android:fontFamily="@font/the_year_of_handicrafts_bold"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="9sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/dhikr_previous"
                android:layout_width="27dp"
                android:layout_height="24dp"
                android:background="@drawable/dhikr_widget_button"
                android:fontFamily="@font/the_year_of_handicrafts_bold"
                android:gravity="center"
                android:text="‹"
                android:textColor="#DDE9FF"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/dhikr_next"
                android:layout_width="27dp"
                android:layout_height="24dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/dhikr_widget_button"
                android:fontFamily="@font/the_year_of_handicrafts_bold"
                android:gravity="center"
                android:text="›"
                android:textColor="#DDE9FF"
                android:textSize="17sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>