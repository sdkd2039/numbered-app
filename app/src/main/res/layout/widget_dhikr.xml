<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:padding="10dp"
    android:background="@drawable/dhikr_widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layoutDirection="rtl">

        <ImageView
            android:id="@+id/dhikr_logo"
            android:layout_width="58dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:contentDescription="الذكر"
            android:scaleType="centerInside"
            android:src="@drawable/male" />

        <TextView
            android:id="@+id/dhikr_category"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical|start"
            android:text="الصباح"
            android:fontFamily="@font/zain_bold"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Zain Bold test -->
    <TextView
        android:id="@+id/dhikr_test_zain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="الصباح"
        android:textAppearance="@style/WidgetZainTextAppearance"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:maxLines="1" />

    <!-- Default system font test -->
    <TextView
        android:id="@+id/dhikr_test_default"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="الصباح"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:maxLines="1" />

    <TextView
        android:id="@+id/dhikr_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:text="جارٍ تحميل الذكر..."
        android:textAppearance="@style/WidgetZainTextAppearance"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:lineSpacingExtra="3dp"
        android:maxLines="5"
        android:ellipsize="end" />

    <LinearLayout
        android:id="@+id/dhikr_counter_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:paddingTop="3dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/dhikr_count"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:background="@drawable/dhikr_counter_background"
            android:text="0"
            android:textAppearance="@style/WidgetZainTextAppearance"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/dhikr_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="TEST123"
            android:textAppearance="@style/WidgetZainTextAppearance"
            android:textColor="#AEBBCC"
            android:textSize="9sp"
            android:maxLines="1" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/dhikr_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:max="100"
        android:progress="0"
        android:indeterminate="false"
        android:progressTint="#62A9F5"
        android:layout_marginBottom="7dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layoutDirection="rtl">

        <TextView
            android:id="@+id/dhikr_previous"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:text="السابق"
            android:textAppearance="@style/WidgetZainTextAppearance"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:background="@drawable/dhikr_button_background" />

        <TextView
            android:id="@+id/dhikr_reset"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:text="تصفير"
            android:textAppearance="@style/WidgetZainTextAppearance"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:background="@drawable/dhikr_button_background" />

        <TextView
            android:id="@+id/dhikr_next"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:text="التالي"
            android:textAppearance="@style/WidgetZainTextAppearance"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:background="@drawable/dhikr_button_background" />

    </LinearLayout>

</LinearLayout>