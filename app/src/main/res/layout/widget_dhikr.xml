<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dhikr_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:layoutDirection="rtl"
    android:padding="12dp"
    android:background="@drawable/dhikr_widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="32dp"
            android:contentDescription="معدودات"
            android:scaleType="centerInside"
            android:src="@drawable/numbered" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/the_year_of_handicrafts_bold"
            android:gravity="center_vertical|end"
            android:text="الذكر"
            android:textColor="#F4F7FB"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/dhikr_widget_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <TextView
            android:id="@+id/dhikr_group_previous"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/dhikr_widget_button"
            android:fontFamily="@font/the_year_of_handicrafts_bold"
            android:gravity="center"
            android:text="‹"
            android:textColor="#D6E7FF"
            android:textSize="25sp" />

        <TextView
            android:id="@+id/dhikr_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/the_year_of_handicrafts_bold"
            android:gravity="center"
            android:textColor="#BFD9FF"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/dhikr_group_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/dhikr_widget_button"
            android:fontFamily="@font/the_year_of_handicrafts_bold"
            android:gravity="center"
            android:text="›"
            android:textColor="#D6E7FF"
            android:textSize="25sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="@drawable/dhikr_widget_surface"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="34dp"
            android:contentDescription="الذكر"
            android:scaleType="centerInside"
            android:src="@drawable/male" />

        <TextView
            android:id="@+id/dhikr_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fontFamily="@font/the_year_of_handicrafts_bold"
            android:gravity="center"
            android:textColor="#F4F7FB"
            android:textDirection="rtl"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/dhikr_count_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/the_year_of_handicrafts_bold"
            android:gravity="center"
            android:textColor="#AEB9C8"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dhikr_counter_card"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:background="@drawable/dhikr_widget_counter"
            android:fontFamily="@font/the_year_of_handicrafts_bold"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/dhikr_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/the_year_of_handicrafts_bold"
            android:gravity="center"
            android:textColor="#AEB9C8"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dhikr_previous"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/dhikr_widget_button"
                android:fontFamily="@font/the_year_of_handicrafts_bold"
                android:gravity="center"
                android:text="‹"
                android:textColor="#D6E7FF"
                android:textSize="27sp" />

            <TextView
                android:id="@+id/dhikr_next"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/dhikr_widget_button"
                android:fontFamily="@font/the_year_of_handicrafts_bold"
                android:gravity="center"
                android:text="›"
                android:textColor="#D6E7FF"
                android:textSize="27sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
