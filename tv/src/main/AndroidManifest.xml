<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- الاتصال بالإنترنت لتحميل محتوى الموقع -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- نشر القنوات والبطاقات في الشاشة الرئيسية لـ Android TV -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />

    <!-- تعريف التطبيق كتطبيق متوافق مع Android TV -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <!-- التطبيق لا يحتاج إلى شاشة لمس -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".NumberedTvApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="معدودات"
        android:banner="@drawable/tv_banner"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="landscape">

            <!-- التشغيل من مشغّلات أندرويد المعتادة -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- الظهور في قائمة تطبيقات التلفزيون -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- نافذة موافقة المستخدم على إضافة القنوات إلى الشاشة الرئيسية (بلا واجهة خاصة) -->
        <activity
            android:name=".channels.ChannelApprovalActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- تجهيز القنوات بعد التثبيت (حدث يرسله نظام Android TV) -->
        <receiver
            android:name=".channels.InitializeProgramsReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.tv.action.INITIALIZE_PROGRAMS" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </receiver>

    </application>

</manifest>